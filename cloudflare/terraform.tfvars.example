# Copy to terraform.tfvars and fill in real values, or set TF_VAR_* environment
# variables instead of writing secrets to disk.

account_id           = "<cloudflare-account-id>"
zone_id              = "<zone-id-for-base-domain>"
tunnel_id            = "<cloudflare-tunnel-uuid>"
base_domain          = "def4alt.com"
cloudflare_api_token = "<token-with-dns-and-tunnel-perms>"

# Optional
manage_tunnel_config = true
manage_dns           = true
tunnel_origin_url    = "https://traefik.infra.svc.cluster.local:443"
minecraft_lb_ip      = "192.168.88.194"
