# vault.def4alt.com: MCP + OAuth, signed downloads, signed uploads. DNS-only (not proxied by
# Cloudflare), so there is no 100 MB body cap. Certificates via HTTP-01/TLS-ALPN.

{
	# Caddy runs unprivileged; Docker maps 80 -> 8080 and 443 -> 8443. With non-standard internal
	# ports, the HTTP->HTTPS redirect is explicit and HTTP/3 is off (it would advertise :8443).
	http_port 8080
	https_port 8443
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
}

http://vault.def4alt.com {
	redir https://vault.def4alt.com{uri} permanent
}

vault.def4alt.com {
	# Downloads: the vault server checks the signature, Caddy serves the bytes (Range, sendfile).
	@blob path_regexp blob ^/f/([0-9a-f]{16,64}(?:\.[a-z0-9]{1,10})?)/[^/]+$
	handle @blob {
		forward_auth mcp:8000 {
			uri /_verify
			header_up X-Forwarded-Uri {http.request.orig_uri}
		}
		root * /srv/blobs
		rewrite * /{re.blob.1}
		header Cache-Control "private, max-age=3600"
		file_server
	}
	handle_path /d/* {
		forward_auth mcp:8000 {
			uri /_verify
			header_up X-Forwarded-Uri {http.request.orig_uri}
		}
		root * /srv/documents
		file_server {
			hide .*
		}
	}

	# Uploads stream through unbuffered; the server enforces size and quota and files them.
	handle /u/* {
		request_body {
			max_size 8GB
		}
		reverse_proxy mcp:8000
	}

	handle /_verify* {
		respond 404
	}
	handle /metrics* {
		respond 404
	}
	handle {
		reverse_proxy mcp:8000
	}

	log
}
